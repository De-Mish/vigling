<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fieldset name="default">
        <field name="registration_type" type="hidden" default="client" filter="word" />
    </fieldset>
    <fields name="profile">
        <fieldset name="profile">
            <field name="phone" type="tel" label="PLG_USER_REGISTRATIONTYPE_PHONE_LABEL" hint="+7 (___) ___-__-__" class="js-phone-mask" filter="string" size="30" />
            <field name="lastname" type="text" label="PLG_USER_REGISTRATIONTYPE_LASTNAME_LABEL" filter="string" size="30" />
            <field name="city" type="text" label="PLG_USER_REGISTRATIONTYPE_CITY_LABEL" filter="string" size="30" />
            <field name="region" type="text" label="PLG_USER_REGISTRATIONTYPE_REGION_LABEL" filter="string" size="30" />
            <field name="address1" type="text" label="PLG_USER_REGISTRATIONTYPE_STREET_LABEL" filter="string" size="30" />
            <field name="address2" type="text" label="PLG_USER_REGISTRATIONTYPE_HOUSE_LABEL" filter="string" size="30" />
            <field name="website" type="url" label="PLG_USER_REGISTRATIONTYPE_WEBSITE_LABEL" filter="string" size="30" />
            <field name="patronymic" type="text" label="PLG_USER_REGISTRATIONTYPE_PATRONYMIC_LABEL" filter="string" size="30" />
            <field name="aboutme" type="textarea" label="PLG_USER_REGISTRATIONTYPE_ABOUTME_LABEL" cols="30" rows="5" filter="safehtml" />
            <field name="master_zatochka_remont" type="checkbox" label="PLG_USER_REGISTRATIONTYPE_MASTER_ZATOCHKA_LABEL" value="1" default="0" filter="integer" />
        </fieldset>
    </fields>
</form>
