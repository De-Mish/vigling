<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_specialists</name>
	<author>Viglin</author>
	<creationDate>2026-02</creationDate>
	<copyright>Viglin</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>1.0.0</version>
	<description>MOD_SPECIALISTS_DESCRIPTION</description>
	<namespace path="src">Joomla\Module\Specialists</namespace>
	<files>
		<folder module="mod_specialists">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<languages>
		<language tag="ru-RU">language/ru-RU/ru-RU.mod_specialists.ini</language>
		<language tag="ru-RU">language/ru-RU/ru-RU.mod_specialists.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="list_url" type="url" default="/specialists-list.php" label="URL страницы списка" description="Относительный или полный URL (specialists-list.php)" />
				<field name="show_categories" type="radio" default="1" label="Показывать выбор категории">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_home_filter" type="radio" default="1" label="Показывать вид услуги">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
